{
	"name": "traversal-lsp",
	"description": "Official VSCode extension for the traversal language server",
	"author": "Michael Feist",
	"publisher": "michael-feist",
	"license": "MIT",
	"version": "0.0.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/michael-feist/traversal.git"
	},
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./out/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
		"watch": "npm run compile -- --watch",
		"vscode:prepublish": "npm run compile"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/vscode": "^1.100.0",
		"@vscode/test-electron": "^2.3.9",
		"esbuild": "^0.28.2",
		"typescript": "^5.7.0",
		"vsce": "^2.15.0",
		"vscode-languageclient": "^10.1.0"
	}
}
